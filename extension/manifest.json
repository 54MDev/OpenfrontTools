{
  "manifest_version": 3,
  "name": "OpenFront Spawn Heatmaps",
  "version": "0.2.1",
  "description": "Overlays ofstats.io spawn heatmaps on OpenFront lobbies/games.",
  "browser_specific_settings": {
    "gecko": {
      "id": "openfront-spawn-heatmaps@ofstats.io"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://openfront.io/*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}
